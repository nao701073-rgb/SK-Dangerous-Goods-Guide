{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "photo-purge-plan.schema.json",
  "title": "Photo Purge Plan",
  "type": "object",
  "required": [
    "id",
    "status",
    "officeId",
    "photoIds",
    "reason",
    "createdBy",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "executed",
        "cancelled"
      ]
    },
    "officeId": {
      "type": "string",
      "minLength": 1
    },
    "office": {
      "type": "string"
    },
    "photoIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "photoCount": {
      "type": "integer",
      "minimum": 1
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "approvedBy": {
      "type": "string"
    },
    "approvedAt": {
      "type": "string"
    },
    "executedBy": {
      "type": "string"
    },
    "executedAt": {
      "type": "string"
    },
    "cancelReason": {
      "type": "string"
    },
    "assignedApprover": {
      "type": "string"
    },
    "approvalDueAt": {
      "type": "string",
      "format": "date-time"
    },
    "executionDueAt": {
      "type": "string"
    },
    "deadlineState": {
      "enum": [
        "none",
        "approval-waiting",
        "approval-overdue",
        "execution-waiting",
        "execution-overdue"
      ]
    },
    "assignmentHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "to",
          "actor",
          "reason",
          "at"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "escalated": {
      "type": "boolean"
    },
    "escalatedBy": {
      "type": "string"
    },
    "escalatedAt": {
      "type": "string"
    },
    "escalationReason": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
