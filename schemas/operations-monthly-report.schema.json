{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspection-support.local/schemas/operations-monthly-report.schema.json",
  "title": "Operations Monthly Report",
  "type": "object",
  "required": ["schemaVersion", "reportId", "month", "generatedAt", "generatedBy", "summary", "verificationHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reportId": { "type": "string", "minLength": 1 },
    "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedBy": { "type": "string", "minLength": 1 },
    "officeId": { "type": "string" },
    "officeName": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["incidentTotal", "incidentOpen", "criticalOpen", "drillCount", "inspectionCompleted", "inspectionOverdue"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "incidents": { "type": "array" },
    "drills": { "type": "array" },
    "inspections": { "type": "array" },
    "verificationHash": { "type": "string", "minLength": 1 }
  }
}
