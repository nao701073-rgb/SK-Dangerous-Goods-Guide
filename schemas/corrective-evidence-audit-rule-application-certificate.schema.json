{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corrective-evidence-audit-rule-application-certificate.schema.json",
  "title": "監査ルール適用証明",
  "type": "object",
  "required": ["schemaVersion", "certificateId", "proposalId", "previousRules", "appliedRules", "approvedBy", "approvedAt", "appliedBy", "appliedAt", "verificationHash", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "certificateId": { "type": "string", "minLength": 1 },
    "proposalId": { "type": "string", "minLength": 1 },
    "proposalType": { "enum": ["change", "rollback"] },
    "reason": { "type": "string" },
    "previousRules": { "$ref": "corrective-evidence-audit-rule.schema.json" },
    "appliedRules": { "$ref": "corrective-evidence-audit-rule.schema.json" },
    "simulationSummary": { "type": "object" },
    "createdBy": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "appliedBy": { "type": "string", "minLength": 1 },
    "appliedAt": { "type": "string", "format": "date-time" },
    "releaseMode": { "enum": ["immediate", "scheduled"] },
    "scheduledAt": { "type": "string" },
    "sourceProposalId": { "type": "string" },
    "verificationHash": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
