{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-reopen-workflow-report.schema.json",
  "title": "案件再開ワークフロー統合報告",
  "type": "object",
  "required": ["schemaVersion", "reportId", "generatedAt", "count", "rows"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "reportId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "generatedBy": {"type": "string"},
    "count": {"type": "integer", "minimum": 0},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["request"],
        "properties": {
          "request": {"type": "object"},
          "investigation": {"type": ["object", "null"]}
        }
      }
    }
  }
}
