{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corrective-evidence-audit-rule-certificate-corrective-action.schema.json",
  "title": "監査ルール適用証明 是正処置",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "issueKey",
    "issueType",
    "title",
    "status",
    "assignedTo",
    "dueAt",
    "cause",
    "actionPlan",
    "createdBy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "issueKey": {
      "type": "string",
      "minLength": 1
    },
    "issueType": {
      "enum": [
        "verification-invalid",
        "proposal-missing",
        "duplicate-certificate-id",
        "duplicate-proposal-id",
        "other",
        "effectiveness-insufficient"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "string"
    },
    "certificateId": {
      "type": "string"
    },
    "proposalId": {
      "type": "string"
    },
    "targetMonth": {
      "type": "string",
      "pattern": "^$|^[0-9]{4}-[0-9]{2}$"
    },
    "officeId": {
      "type": "string"
    },
    "office": {
      "type": "string"
    },
    "cause": {
      "type": "string",
      "minLength": 1
    },
    "actionPlan": {
      "type": "string",
      "minLength": 1
    },
    "assignedTo": {
      "type": "string",
      "minLength": 1
    },
    "dueAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "open",
        "pending-verification",
        "closed"
      ]
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedBy": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "completionNote": {
      "type": "string"
    },
    "verifiedBy": {
      "type": "string"
    },
    "verifiedAt": {
      "type": "string"
    },
    "verificationNote": {
      "type": "string"
    },
    "effectivenessStatus": {
      "enum": [
        "pending",
        "effective",
        "ineffective"
      ]
    },
    "effectivenessDueAt": {
      "type": "string"
    },
    "effectivenessCriteria": {
      "type": "string"
    },
    "effectivenessScheduledBy": {
      "type": "string"
    },
    "effectivenessScheduledAt": {
      "type": "string"
    },
    "effectivenessReviewedBy": {
      "type": "string"
    },
    "effectivenessReviewedAt": {
      "type": "string"
    },
    "effectivenessResultNote": {
      "type": "string"
    },
    "followUpCorrectiveActionRequired": {
      "type": "boolean"
    },
    "followUpCorrectiveActionId": {
      "type": "string"
    },
    "parentCorrectiveActionId": {
      "type": "string"
    },
    "progressPercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "latestProgressNote": {
      "type": "string"
    },
    "progressUpdatedBy": {
      "type": "string"
    },
    "progressUpdatedAt": {
      "type": "string"
    },
    "progressHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "progressPercent",
          "note",
          "updatedBy",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "progressPercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "note": {
            "type": "string"
          },
          "updatedBy": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    },
    "assignmentHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assignedTo",
          "reason",
          "changedBy",
          "changedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "previousAssignedTo": {
            "type": "string"
          },
          "assignedTo": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "changedBy": {
            "type": "string"
          },
          "changedAt": {
            "type": "string"
          }
        }
      }
    },
    "reassignedBy": {
      "type": "string"
    },
    "reassignedAt": {
      "type": "string"
    },
    "reassignmentReason": {
      "type": "string"
    },
    "followUpResolvedAt": {
      "type": "string"
    },
    "followUpResolvedBy": {
      "type": "string"
    },
    "followUpResolutionNote": {
      "type": "string"
    },
    "followUpReevaluationStatus": {
      "type": "string",
      "enum": [
        "not-scheduled",
        "pending",
        "no-recurrence",
        "recurrence-detected"
      ]
    },
    "followUpReevaluationDueAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "followUpReevaluationCriteria": {
      "type": "string"
    },
    "followUpReevaluationScheduledBy": {
      "type": "string"
    },
    "followUpReevaluationScheduledAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "followUpReevaluationReviewedBy": {
      "type": "string"
    },
    "followUpReevaluationReviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "followUpReevaluationNote": {
      "type": "string"
    },
    "caseClosureStatus": {
      "type": "string",
      "enum": [
        "not-ready",
        "pending-approval",
        "blocked",
        "closed"
      ]
    },
    "caseClosedBy": {
      "type": "string"
    },
    "caseClosedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "caseClosureNote": {
      "type": "string"
    },
    "followUpCorrectiveActionHistory": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
