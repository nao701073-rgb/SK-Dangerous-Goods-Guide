{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspection-support.local/schemas/regulation-update-manifest.schema.json",
  "title": "Regulation update manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "regulationId",
    "updateType",
    "editionLabel",
    "effectiveFrom",
    "sourceDocument",
    "dataset",
    "comparison",
    "verification",
    "impactAssessment",
    "approval",
    "temporalPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3"
    },
    "regulationId": {
      "type": "string",
      "minLength": 1
    },
    "updateType": {
      "enum": [
        "amendment",
        "new-edition",
        "correction",
        "translation-update"
      ]
    },
    "editionLabel": {
      "type": "string",
      "minLength": 1
    },
    "publicationDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sourceDocument": {
      "type": "object",
      "required": [
        "fileName",
        "language",
        "checksumSha256"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "\\.pdf$"
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "publisher": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "checksumSha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": [
        "fileName",
        "format",
        "schemaVersion",
        "targetKeys",
        "recordKey"
      ],
      "properties": {
        "fileName": {
          "type": "string"
        },
        "format": {
          "enum": [
            "json",
            "csv"
          ]
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recordKey": {
          "type": "string",
          "minLength": 1
        },
        "expectedRecordCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "baselineRevisionId",
        "expectedMaximumDeletionCount"
      ],
      "properties": {
        "baselineRevisionId": {
          "type": "string"
        },
        "baselineFileName": {
          "type": "string"
        },
        "expectedMaximumDeletionCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "changeSummary": {
      "type": "string"
    },
    "verification": {
      "type": "object",
      "required": [
        "reviewer",
        "checkedItems",
        "sourcePageReferences"
      ],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "checkedItems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "sourcePageReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "pages"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "pages": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "impactAssessment": {
      "type": "object",
      "required": [
        "affectedRegulations",
        "reviewDomains",
        "allAffectedTargetsReviewed"
      ],
      "properties": {
        "affectedRegulations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allAffectedTargetsReviewed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "preparedBy",
        "approvedBy",
        "selfApprovalProhibited"
      ],
      "properties": {
        "preparedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "selfApprovalProhibited": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "temporalPolicy": {
      "type": "object",
      "required": [
        "asOfDateRequired",
        "overlapProhibited",
        "retainHistoricalVersions"
      ],
      "properties": {
        "asOfDateRequired": {
          "const": true
        },
        "overlapProhibited": {
          "const": true
        },
        "retainHistoricalVersions": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
