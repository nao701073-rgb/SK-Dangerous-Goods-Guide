{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example.invalid/schemas/application-common-case.schema.json",
  "title": "申請番号管理・固縛力参考算出 共通案件情報",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "applicantName": { "type": "string", "maxLength": 200 },
    "shipper": { "type": "string", "maxLength": 300 },
    "loadingPort": { "type": "string", "maxLength": 150 },
    "dischargePort": { "type": "string", "maxLength": 150 },
    "containerType": { "type": "string", "maxLength": 100 },
    "cargoItems": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "maxLength": 100 },
          "lineNo": { "type": "integer", "minimum": 1 },
          "unNumber": { "type": "string", "pattern": "^[0-9]{4}$" },
          "properShippingNameJa": { "type": "string", "maxLength": 500 },
          "properShippingNameEn": { "type": "string", "maxLength": 500 },
          "originalName": { "type": "string", "maxLength": 1000 },
          "hazardClass": { "type": "string", "maxLength": 30 },
          "subsidiaryHazards": { "type": "string", "maxLength": 100 },
          "packingGroup": { "type": "string", "enum": ["", "I", "II", "III", "not_applicable"] },
          "containerCode": { "type": "string", "maxLength": 200 },
          "packageForm": { "type": "string", "maxLength": 200 },
          "packageCount": { "type": ["number", "null"], "minimum": 0 },
          "netMassPerPackageKg": { "type": ["number", "null"], "minimum": 0 },
          "grossMassPerPackageKg": { "type": ["number", "null"], "minimum": 0 },
          "totalNetMassKg": { "type": ["number", "null"], "minimum": 0 },
          "totalGrossMassKg": { "type": ["number", "null"], "minimum": 0 },
          "packingInstruction": { "type": "string", "maxLength": 200 },
          "allowableCapacityOrMass": { "type": "string", "maxLength": 2000 },
          "permissionRequired": { "type": "boolean" },
          "permissionNote": { "type": "string", "maxLength": 2000 },
          "resultStatus": { "type": "string", "maxLength": 100 },
          "warning": { "type": "string", "maxLength": 2000 },
          "sourcePath": { "type": "string", "maxLength": 1000 },
          "sourcePageStart": { "type": ["number", "null"], "minimum": 1 },
          "sourcePageEnd": { "type": ["number", "null"], "minimum": 1 }
        }
      }
    }
  },
  "required": ["cargoItems"]
}
