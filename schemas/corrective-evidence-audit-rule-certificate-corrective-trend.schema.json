{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corrective-evidence-audit-rule-certificate-corrective-trend.schema.json",
  "title": "監査ルール適用証明是正処置 月次傾向報告",
  "type": "object",
  "required": ["schemaVersion", "reportId", "targetMonth", "generatedAt", "summary", "byCause", "byIssue", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reportId": { "type": "string", "minLength": 1 },
    "targetMonth": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedBy": { "type": "string" },
    "summary": { "type": "object" },
    "byCause": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "byIssue": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "records": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
