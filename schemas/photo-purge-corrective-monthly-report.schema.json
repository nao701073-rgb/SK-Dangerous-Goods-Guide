{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "photo-purge-corrective-monthly-report.schema.json",
  "title": "Photo Purge Corrective Action Monthly Report",
  "type": "object",
  "required": ["schemaVersion", "reportType", "targetMonth", "generatedAt", "generatedBy", "totals", "offices", "actions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reportType": { "const": "photo-purge-corrective-action-monthly" },
    "targetMonth": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedBy": { "type": "string", "minLength": 1 },
    "totals": {
      "type": "object",
      "required": ["total", "open", "awaitingVerification", "overdue", "escalated", "closed"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "open": { "type": "integer", "minimum": 0 },
        "awaitingVerification": { "type": "integer", "minimum": 0 },
        "overdue": { "type": "integer", "minimum": 0 },
        "escalated": { "type": "integer", "minimum": 0 },
        "closed": { "type": "integer", "minimum": 0 }
      }
    },
    "offices": { "type": "array", "items": { "type": "object" } },
    "actions": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": false
}
