NODE_ENV=production
PORT=8080
POSTGRES_DB=inspection_support
POSTGRES_USER=inspection_user
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD
DATABASE_URL=postgresql://inspection_user:CHANGE_THIS_DB_PASSWORD@db:5432/inspection_support
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h
CORS_ORIGINS=https://inspection.internal.example.jp
PHOTO_STORAGE_DIR=/app/storage/photos
TRUST_PROXY=1

# Local authentication. Disable after OIDC/AD integration is verified.
ALLOW_LOCAL_AUTH=true
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_AGE_DAYS=180
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=30


# Initial release: administrator-assigned login ID + password
# Email two-factor authentication is reserved for a future release
MFA_ENABLED=false
MFA_CODE_MINUTES=10
MFA_MAX_ATTEMPTS=5
MFA_RESEND_SECONDS=60
ACCOUNT_TOKEN_MINUTES=1440
PUBLIC_APP_URL=https://inspection.internal.example.jp

# Internal SMTP server for one-time codes and activation links
SMTP_HOST=mail.internal.example.jp
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=inspection-support
SMTP_PASS=CHANGE_THIS_SMTP_PASSWORD
SMTP_FROM=検査・検品業務サポートシステム <inspection-support@internal.example.jp>
SMTP_REJECT_UNAUTHORIZED=true

# Future OIDC / Entra ID settings
OIDC_ENABLED=false
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<client-id>
OIDC_AUDIENCE=<api-audience>

DEFAULT_PHOTO_PER_APPLICATION=20
DEFAULT_PHOTO_PER_OFFICE=1000
DEFAULT_PHOTO_MAX_FILE_MB=8
DEFAULT_PHOTO_STORAGE_MB=500
AUDIT_RETENTION_DAYS=365

BOOTSTRAP_ADMIN_LOGIN_ID=safety-admin
BOOTSTRAP_ADMIN_EMAIL=safety-admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeImmediately123!
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# 社内検証用初期データ投入時のみ使用します。
# 実行後は値を削除または変更してください。
VALIDATION_INITIAL_PASSWORD=ChangeMe!2026

# Browser inactivity timeout
SESSION_IDLE_MINUTES=30

# Safety and Environment Office Director administrator succession cutover
ADMIN_SUCCESSION_ENABLED=false

# Part 503: central attachment storage
# filesystem: persistent volume. s3: S3-compatible object storage.
STORAGE_PROVIDER=filesystem
ATTACHMENT_STORAGE_DIR=/app/storage/photos
S3_BUCKET=
S3_REGION=ap-northeast-1
S3_ENDPOINT=
S3_PREFIX=inspection-support
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256

# Automatic backups. OFFSITE_BACKUP_COMMAND receives BACKUP_SET_DIR and BACKUP_ID.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
OFFSITE_BACKUP_COMMAND=
OFFSITE_BACKUP_LOCATION=

# Part 506: full-system migration staging (disabled by default)
SYSTEM_MIGRATION_ENABLED=false
SYSTEM_MIGRATION_STAGING_DIR=/srv/inspection-support/migration-staging
SYSTEM_MIGRATION_RELEASE_DIR=/srv/inspection-support/releases
SYSTEM_MIGRATION_SOURCE_ORIGINS=https://nao701073-rgb.github.io
SYSTEM_MIGRATION_MAX_FILES=5000
SYSTEM_MIGRATION_MAX_BYTES=1073741824

# Part 507: server-side session authentication (required for production)
SERVER_SESSION_ENABLED=true
SESSION_COOKIE_NAME=__Host-iss_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=Strict
SESSION_COOKIE_DOMAIN=
SESSION_ABSOLUTE_HOURS=8
SESSION_REMEMBER_DAYS=7
SESSION_TOUCH_INTERVAL_SECONDS=60
SESSION_FINGERPRINT_SALT=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
SESSION_BIND_USER_AGENT=true
SESSION_BIND_IP=false
SESSION_MAX_ACTIVE_PER_USER=10
CSRF_HEADER_NAME=x-csrf-token
CSRF_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
LEGACY_BEARER_AUTH_ENABLED=false
ENFORCE_HTTPS=true

# Part 509: copyright and publication scope
PUBLICATION_SCOPE=prototype-review
REQUIRE_APPROVED_PUBLIC_ASSETS=false
PUBLIC_BUILD_OUTPUT_DIR=./data/public-release

# Part 510: backup, isolated restore and migration drills
BACKUP_DIR=/backups
BACKUP_INCLUDE_SYSTEM_RELEASE=true
SYSTEM_RELEASE_SOURCE_DIR=/app/public
SYSTEM_RELEASE_OUTPUT_DIR=/tmp/system-release
SYSTEM_CURRENT_RELEASE_LINK=/app/current
RECOVERY_EVIDENCE_DIR=/app/recovery-evidence
RECOVERY_RPO_MINUTES=1440
RECOVERY_RTO_MINUTES=240
# Keep false on web/API servers. Run backup/restore/cutover scripts from an approved operations host.
RECOVERY_COMMAND_EXECUTION_ENABLED=false
# Optional independent copy to a second storage/account/region.
# OFFSITE_BACKUP_COMMAND=aws s3 sync "$BACKUP_SET_DIR" "s3://independent-backup/$BACKUP_ID" --sse AES256
# OFFSITE_BACKUP_LOCATION=s3://independent-backup
