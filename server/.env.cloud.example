NODE_ENV=production
PORT=8080

# クラウド提供のマネージドPostgreSQL接続文字列
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# 64文字以上のランダム値をクラウドのSecret機能へ登録
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h
SESSION_IDLE_MINUTES=30
TRUST_PROXY=1

# 公開する画面とAPIのURL
PUBLIC_APP_URL=https://guide.example.jp
CORS_ORIGINS=https://guide.example.jp

# クラウドの永続ディスクを割り当てる場合の保存先
PHOTO_STORAGE_DIR=/var/data/photos

ALLOW_LOCAL_AUTH=true
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_AGE_DAYS=180
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=30

MFA_ENABLED=false
MFA_CODE_MINUTES=10
MFA_MAX_ATTEMPTS=5
MFA_RESEND_SECONDS=60
ACCOUNT_TOKEN_MINUTES=1440

# 外部メール配信サービスまたは組織のSMTP
SMTP_HOST=smtp.example.jp
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=inspection-support
SMTP_PASS=REPLACE_WITH_SECRET
SMTP_FROM=検査・検品業務サポートシステム <no-reply@example.jp>
SMTP_REJECT_UNAUTHORIZED=true

# 将来のMicrosoft Entra ID等との連携枠
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

DEFAULT_PHOTO_PER_APPLICATION=20
DEFAULT_PHOTO_PER_OFFICE=1000
DEFAULT_PHOTO_MAX_FILE_MB=8
DEFAULT_PHOTO_STORAGE_MB=500
AUDIT_RETENTION_DAYS=365

BOOTSTRAP_ADMIN_LOGIN_ID=system-admin
BOOTSTRAP_ADMIN_EMAIL=system-admin@example.jp
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_TEMPORARY_SECRET

# Safety and Environment Office Director administrator succession cutover
ADMIN_SUCCESSION_ENABLED=false

# Part 503: use a persistent disk or S3-compatible object storage.
STORAGE_PROVIDER=s3
ATTACHMENT_STORAGE_DIR=/var/data/attachments
S3_BUCKET=inspection-support-production
S3_REGION=ap-northeast-1
S3_ENDPOINT=
S3_PREFIX=production
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256

BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
OFFSITE_BACKUP_COMMAND=
OFFSITE_BACKUP_LOCATION=

# Full-system migration: enable only during an approved migration window.
SYSTEM_MIGRATION_ENABLED=false
SYSTEM_MIGRATION_STAGING_DIR=/data/migration-staging
SYSTEM_MIGRATION_RELEASE_DIR=/data/releases
SYSTEM_MIGRATION_SOURCE_ORIGINS=https://nao701073-rgb.github.io
SYSTEM_MIGRATION_MAX_FILES=5000
SYSTEM_MIGRATION_MAX_BYTES=1073741824

# Copyright/publication scope
PUBLICATION_SCOPE=internal-authenticated
REQUIRE_APPROVED_PUBLIC_ASSETS=true
PUBLIC_BUILD_OUTPUT_DIR=/data/public-release

# Part 510: backup, restore and full-system migration drills
RECOVERY_BACKUP_DIR=/backups
RECOVERY_RELEASE_DIR=/data/releases
RECOVERY_STAGING_DIR=/data/recovery-staging
RECOVERY_CURRENT_LINK=/opt/sk-guide/current
RECOVERY_RPO_HOURS=24
RECOVERY_RTO_MINUTES=240
RECOVERY_RETENTION_DAYS=30
RECOVERY_HEALTHCHECK_URL=https://example.internal/api/health
RECOVERY_DRILL_DATABASE_PREFIX=sk_restore_drill
RECOVERY_REQUIRE_OFFSITE_COPY=true
RECOVERY_REQUIRE_RESTORE_DRILL=true
