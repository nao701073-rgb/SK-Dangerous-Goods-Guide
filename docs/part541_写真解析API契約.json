{
  "schemaVersion": "part541-v1",
  "endpoint": "POST /api/ctu/photo-analysis",
  "purpose": "CTU固縛写真から入力候補を返す。安全判定・MSL確定は行わない。",
  "request": {
    "schemaVersion": "part541-v1",
    "imageDataUrl": "data:image/jpeg;base64,...",
    "context": {
      "cargoDescription": "",
      "containerNumber": "",
      "transportPreset": "seaB",
      "photoStage": "complete"
    }
  },
  "response": {
    "analysis": {
      "summary": "",
      "cargoUnits": [
        {
          "type": "rack",
          "description": "シリンダーラック",
          "position": "rear",
          "count": 2,
          "confidence": 0.9
        }
      ],
      "securingElements": [
        {
          "type": "webbing",
          "material": "polyester",
          "position": "upper",
          "connection": "rackCtu",
          "direction": "forward",
          "count": 2,
          "angle": 45,
          "marking": "",
          "confidence": 0.82,
          "note": "クロス状のベルト候補"
        }
      ],
      "unreadable": [
        "CTU側取付点MSL",
        "ベルト表示"
      ]
    }
  },
  "allowedCargoUnitTypes": [
    "single",
    "pallet",
    "rack",
    "skid",
    "drums",
    "cylinders",
    "mixed",
    "multilevel"
  ],
  "allowedElementTypes": [
    "webbing",
    "steelBand",
    "wire",
    "rope",
    "pet",
    "pp",
    "tygard",
    "timber",
    "panel",
    "bulkhead",
    "rack",
    "pallet",
    "wrap",
    "other",
    "unknown"
  ],
  "rules": [
    "画像のみからMSL・許容荷重・木材強度・ラック強度を確定しない",
    "不明はunknownまたはunreadableで返す",
    "confidenceを0から1で返す",
    "安全・適合の最終判定を返さない"
  ]
}